{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/papi/task.schema.json",
  "title": "PAPI Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "department", "owner_agent", "status", "priority", "created_at", "approval_required"],
  "properties": {
    "id": {"type":"string","pattern":"^[A-Z0-9][A-Z0-9_-]{2,40}$"},
    "title": {"type":"string","minLength":3,"maxLength":160},
    "description": {"type":"string","maxLength":5000},
    "department": {"type":"string","minLength":2,"maxLength":80},
    "owner_agent": {"type":"string","minLength":2,"maxLength":80},
    "status": {"enum":["backlog","ready","in_progress","blocked","review","done","cancelled"]},
    "priority": {"enum":["low","normal","high","urgent"]},
    "created_at": {"type":"string","format":"date-time"},
    "due_at": {"type":"string","format":"date-time"},
    "approval_required": {"type":"boolean"},
    "approval_status": {"enum":["not_required","pending","approved","rejected"]},
    "result_url": {"type":"string","format":"uri"},
    "evidence": {"type":"array","items":{"type":"string","maxLength":500}},
    "notes": {"type":"string","maxLength":3000}
  }
}