{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sleepyshorts37-commits/papi-commerce-ai/blob/main/schemas/provider-registry.schema.json",
  "title": "PAPI CONNECT Provider Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "capabilities",
        "status",
        "enabled",
        "external",
        "pricing",
        "quota",
        "required_permissions",
        "credentials_env",
        "data_classes",
        "region_scope",
        "docs_url",
        "pricing_url",
        "last_verified_at",
        "owner_approval_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "enum": [
            "llm",
            "automation",
            "observability",
            "storage",
            "tools",
            "local_runtime",
            "search",
            "media",
            "other"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,63}$"
          }
        },
        "status": {
          "enum": [
            "proposed",
            "verified",
            "enabled",
            "disabled",
            "deprecated"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "currency",
            "free_quota",
            "trial_days",
            "notes"
          ],
          "properties": {
            "model": {
              "enum": [
                "unknown",
                "free",
                "quota",
                "trial",
                "usage_based",
                "subscription",
                "one_time"
              ]
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{3}$"
            },
            "free_quota": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 500
            },
            "trial_days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 365
            },
            "notes": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        "quota": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests_per_minute",
            "requests_per_day",
            "monthly_limit",
            "max_cost_xof"
          ],
          "properties": {
            "requests_per_minute": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "requests_per_day": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "monthly_limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_cost_xof": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required_permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,63}$"
          }
        },
        "credentials_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
          }
        },
        "data_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal",
              "financial",
              "credentials"
            ]
          }
        },
        "region_scope": {
          "type": "string",
          "maxLength": 120
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "pricing_url": {
          "type": "string",
          "format": "uri"
        },
        "last_verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "owner_approval_required": {
          "type": "boolean"
        }
      }
    }
  }
}
