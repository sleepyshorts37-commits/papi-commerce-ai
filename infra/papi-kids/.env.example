# Copy to .env on the server and replace every placeholder with a server secret.
# Never commit the real .env file or paste secrets into ChatGPT/GitHub.
PAPI_KIDS_PRIVATE_STORAGE_DIR=/data/private
PAPI_KIDS_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PAPI_KIDS_UPLOAD_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
PAPI_KIDS_REVIEW_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
PAPI_KIDS_REVIEWER_ID=owner-01
PAPI_KIDS_WORKER_ENABLED=false
PAPI_KIDS_WORKER_ID=papi-kids-worker-01

# Cloudflare credentials are not needed for manuscript intake or editorial analysis.
# Add only after separate quota evidence and explicit authorization.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# One-shot encrypted backup runner; remains disabled until an operator enables it.
PAPI_KIDS_BACKUP_ENABLED=false
PAPI_KIDS_BACKUP_DIRECTORY=/data/backups
PAPI_KIDS_BACKUP_KEY_ID=backup-key-2026-01
# Generate a random 32-byte key and Base64-encode it; keep it outside the repository.
# PAPI_KIDS_BACKUP_KEY_B64=

# Offsite copy is separate, disabled by default; rclone config stays outside Git.
PAPI_KIDS_OFFSITE_ENABLED=false
PAPI_KIDS_BACKUP_REMOTE=drive:papi-kids-backups
# Set this to the absolute path of a chmod 0600 rclone.conf on the server.
PAPI_KIDS_RCLONE_CONFIG_FILE=/secure/path/rclone.conf

# Distinct owner token for approving/rejecting child-safety reviews.
# PAPI_KIDS_SAFETY_REVIEW_TOKEN=replace-with-a-separate-random-32-plus-character-token
# PAPI_KIDS_REVIEWER_ID=owner-01

# Non-secret defaults for the iPhone dashboard page.
PAPI_KIDS_DASHBOARD_BOOK_ID=PKP-0001
PAPI_KIDS_DASHBOARD_TITLE=Nia et la rivière aux mille reflets
PAPI_KIDS_DASHBOARD_PAGE_COUNT=24

# Separate token/editor identity for KDP listing metadata drafts.
# PAPI_KIDS_METADATA_TOKEN=replace-with-a-separate-random-32-plus-character-token
# PAPI_KIDS_METADATA_EDITOR_ID=owner-01

# Explicit KDP package build is disabled until the owner enables it.
PAPI_KIDS_KDP_BUILD_ENABLED=false
# PAPI_KIDS_KDP_BUILD_TOKEN=replace-with-a-separate-random-32-plus-character-token

# Secret-safe readiness endpoint, separate from all workflow tokens.
# PAPI_KIDS_READINESS_TOKEN=replace-with-a-separate-random-32-plus-character-token

# Separate token for reviewing/downloading KDP PDFs and EPUBs.
# PAPI_KIDS_KDP_REVIEW_TOKEN=replace-with-a-separate-random-32-plus-character-token

# Separate read-only token for final KDP release readiness checks.
# PAPI_KIDS_RELEASE_GATE_TOKEN=replace-with-a-separate-random-32-plus-character-token
